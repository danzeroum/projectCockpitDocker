# SEGREDO — o escopo autorizado REAL (host + prova de posse) nunca entra num repo público.
# Ele é injetado como segredo no CI; o que vive versionado é só o .example ao lado.
tests/qa/escopo-autorizado.yaml

# SEGREDO — o .env de homologação carrega a credencial do basic auth do ingress.
# Ele é preenchido NO SERVIDOR; aqui vive só o .example.
deploy/homologacao/.env

# Evidência da harness — efêmera, nunca versionada
harness/runs/*
harness/reports/*
harness/state/*
!harness/runs/.gitkeep
!harness/reports/.gitkeep
!harness/state/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Ambientes virtuais
.venv/
venv/
env/

# Laudos e evidência solta
*.evidence
report/
