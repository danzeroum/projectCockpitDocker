# Evidência da harness — efêmera, nunca versionada
harness/runs/*
harness/reports/*
harness/state/*
!harness/runs/.gitkeep
!harness/reports/.gitkeep
!harness/state/.gitkeep
# EXCEÇÃO DECLARADA (CP-026 / ADR-021, e o item 5 do RIPD foi atualizado no mesmo PR): o ledger é
# versionado porque evidência durável é o ponto dele. A medida de proteção não sumiu — mudou de
# lugar, do .gitignore para o schema: ledger.schema.json não tem campo textual livre, então não
# existe onde escrever dado pessoal. Minimização estrutural, não promessa.
!harness/state/ledger.jsonl

# Baseline da catraca (ci/catraca.py). Pela MESMA razão do ledger acima: `harness/state/*` ignora
# evidência derivada, e estes dois não são derivados — são fonte de verdade versionada. Sem esta
# linha o `git add -A` pula o arquivo em silêncio e a catraca chega ao runner sem o baseline que
# ela existe para comparar. Aconteceu, no primeiro PR que a instituiu.
!harness/state/baseline-achados.json

# Código do ALVO materializado por ci/bootstrap.py no SHA de target.lock. Não é versionado
# porque o derivado DECLARA o alvo e nunca o copia (ADR-008): uma cópia versionada derivaria do
# original em silêncio, e o metadado passaria a descrever um sistema que não existe mais.
workspace/*
!workspace/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Ambientes virtuais
.venv/
venv/
env/

# Laudos e evidência solta
*.evidence
report/
